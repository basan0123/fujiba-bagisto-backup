#!/bin/bash
# Run a heavy image/matcher job: one at a time (shared /run/lock/fujiba-heavy.lock,
# same lock the Python heavy_guard uses) inside fujiba-heavy.slice (MemoryMax=3G),
# at nice 10 / idle IO. Exits 75 if the lock is not free within FUJIBA_HEAVY_WAIT s.
# Usage: fujiba-heavy <command> [args...]
set -euo pipefail
exec flock -w "${FUJIBA_HEAVY_WAIT:-3600}" -E 75 /run/lock/fujiba-heavy.lock \
  systemd-run --quiet --scope --slice=fujiba-heavy.slice -p MemoryMax=3G -p MemorySwapMax=0 \
  env FUJIBA_HEAVY_HELD=1 nice -n 10 ionice -c3 "$@"
